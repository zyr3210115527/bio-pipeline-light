{
  "mcpServers": {
    "bio-pipeline-light": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CWD}/mcp_light_server.py"],
      "env": {
        "NEO4J_USER": "${NEO4J_USER}",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "NEO4J_URL": "http://127.0.0.1:7474/db/neo4j/tx/commit"
      }
    }
  }
}
